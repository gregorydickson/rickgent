{
  "schema_version": "1.0.0",
  "release_id": "rickgent-trust-spine-release-v1",
  "contract_mode": "cross-language-authoritative",
  "description": "Single authoritative cross-language release manifest for the Rickgent trust-spine release. The supported install is assembled only from one npm tarball and one non-editable rickgent-policies wheel. Omnigent is the sole explicitly mounted external dependency and remains governed by behavioral current compatibility.",
  "mission_3_contract": {
    "path": "docs/architecture/reliability/mission-3-release-contract.json",
    "contract_id": "rickgent-mission-3-release-v1"
  },
  "version": {
    "npm": "0.1.0-alpha",
    "python": "0.1.0a0",
    "cli_display": "0.1.0-alpha",
    "docs": "0.1.0-alpha"
  },
  "license": {
    "spdx": "Apache-2.0",
    "file": "LICENSE",
    "npm_field": "orchestrator/package.json#license",
    "python_field": "rickgent-policies/pyproject.toml#project.license"
  },
  "toolchain": {
    "node": {
      "range": ">=24.0.0 <25.0.0",
      "source": "orchestrator/package.json#engines.node"
    },
    "python": {
      "range": ">=3.12.0,<3.15.0",
      "source": "rickgent-policies/pyproject.toml#project.requires-python"
    },
    "package_manager": {
      "name": "pnpm",
      "version": "10.22.0",
      "lockfile": "orchestrator/pnpm-lock.yaml",
      "lockfile_version": "9.0",
      "source": "orchestrator/package.json#packageManager"
    },
    "platforms": {
      "supported": ["darwin", "linux"],
      "windows": "fail_fast",
      "windows_error_code": "RICKGENT_PLATFORM_UNSUPPORTED"
    }
  },
  "build_identity": {
    "commit_source": "orchestrator/src/build-commit.ts#BUILD_COMMIT",
    "regenerator": "orchestrator/scripts/generate-build-commit.cjs",
    "cli_version_flag": "--version",
    "cli_build_commit_flag": "--build-commit",
    "build_commit_format": "40-char lowercase hex git SHA; the literal \"dev\" is a build failure",
    "lag_by_one_note": "The committed build-commit.ts intentionally references the parent of the amended HEAD; runtime parity is established by init.sh rebuilding dist to the current HEAD."
  },
  "omnigent_compatibility": {
    "contract": "artifacts/reliability/omnigent-compatibility-contract.json",
    "contract_id": "rickgent-omnigent-current-compatible-v1",
    "contract_mode": "current-compatible",
    "verifier": "orchestrator/scripts/verify-omnigent-contract.mjs",
    "root_env": "OMNIGENT_ROOT",
    "python_env": "OMNIGENT_PYTHON",
    "selection": ["OMNIGENT_ROOT", "OMNIGENT_PYTHON"],
    "compatibility_authority": "offline behavioral probe",
    "observed_version_role": "provenance only",
    "observed_git_oid_role": "provenance only",
    "exact_sha_is_authority": false,
    "access": "read-only",
    "pin": "No version or Git SHA is compatibility authority. Behavioral current compatibility is proven against the explicitly selected read-only root and interpreter, with import-origin containment."
  },
  "package_contents": {
    "npm": {
      "manifest": "orchestrator/package.json",
      "pack_command": "cd orchestrator && npm pack --dry-run --json",
      "inventory_artifact": "artifacts/reliability/npm-pack-inventory.json",
      "must_include": [
        "dist/cli.js",
        "dist/pnpm-lock.yaml",
        "agents/rickgent/",
        "runtime/resource-map.json",
        "LICENSE",
        "proof/metadata.json",
        "validators/"
      ],
      "must_exclude": [
        "test/",
        "src/",
        "node_modules/",
        "dist/testing/",
        "dist/internal/",
        "dist-fixture/",
        "fixtures/",
        ".tsbuildinfo"
      ],
      "owns": [
        "compiled_cli",
        "agent_bundles",
        "runtime_lookup_metadata",
        "LICENSE",
        "immutable_proof_metadata",
        "package_validation_resources"
      ],
      "role": "complete Rickgent JavaScript runtime archive; no checkout resource fallback"
    },
    "python": {
      "manifest": "rickgent-policies/pyproject.toml",
      "build_command": "python3 -m build rickgent-policies --outdir artifacts/reliability/python-dist",
      "dist_artifact": "artifacts/reliability/python-dist",
      "package": "rickgent-policies",
      "import_module": "rickgent_policies",
      "must_include_modules": ["rickgent_policies"],
      "must_exclude": ["test/", "__pycache__", ".egg-info", ".venv", "direct_url.json", "*.pth", "*.egg-link"],
      "install_mode": "non_editable_wheel",
      "owns": ["rickgent_policies"],
      "role": "non-editable pure-Python policy wheel over the TypeScript verdict core"
    }
  },
  "installer": {
    "script": "install.sh",
    "model": "archive_only_install",
    "description": "install.sh installs the already-built npm tarball and non-editable rickgent-policies wheel into isolated roots, binds the explicitly selected compatible Omnigent root and interpreter, links the installed launcher, and runs the installed doctor as a fail-closed behavioral gate. It performs no source build and resolves no checkout resource.",
    "installs": [
      "rickgent npm tarball (archive bytes only)",
      "rickgent-policies wheel (pip install without editable or source fallback)",
      "omnigent (explicit read-only external mount selected by OMNIGENT_ROOT and OMNIGENT_PYTHON)"
    ],
    "builds_from_source": false,
    "checkout_resource_resolution_allowed": false,
    "editable_install_allowed": false,
    "links_executable": true,
    "executable": "rickgent",
    "launcher_source": "rickgent",
    "doctor_gate": "node orchestrator/dist/cli.js doctor",
    "doctor_failure_is_fatal": true,
    "preserves_unrelated_user_data": true,
    "idempotent": true
  },
  "runtime_paths": {
    "cli_entrypoint": "orchestrator/dist/cli.js",
    "launcher": "rickgent",
    "agent_bundles": "agents/rickgent",
    "manager_bundle": "npm:agents/rickgent/config.yaml",
    "worker_bundle": "npm:agents/rickgent/agents/worker/config.yaml",
    "runtime_lookup_metadata": "npm:runtime/resource-map.json",
    "license": "npm:LICENSE",
    "proof_metadata": "npm:proof/metadata.json",
    "validation_resources": "npm:validators/",
    "policies_module": "rickgent_policies",
    "policies_source": "rickgent-policies/rickgent_policies",
    "state_dir": ".rickgent/",
    "state_dir_env": "RICKGENT_DIR"
  },
  "assembly_plan": {
    "model": "archives_only",
    "npm_package_role": "complete_javascript_runtime",
    "agent_bundles_source": "npm_tarball",
    "policies_source": "non_editable_wheel",
    "omnigent_source": "explicit read-only mount selected by OMNIGENT_ROOT and OMNIGENT_PYTHON",
    "allowed_mounted_external_dependencies": ["omnigent"],
    "checkout_resource_resolution_allowed": false,
    "editable_rickgent_install_allowed": false,
    "source_build_allowed": false,
    "clean_packed_install_requirement": "The compiled CLI, agent bundles, runtime metadata, LICENSE, proof metadata, validators, and rickgent_policies resolve only from installed archive roots. Omnigent is the sole mounted external dependency; any checkout, editable, or source-tree fallback invalidates the install."
  },
  "validators": {
    "manifest": "orchestrator/scripts/validate-release-manifest.mjs",
    "package_inventory": "orchestrator/scripts/assert-package-inventory.mjs",
    "omnigent_contract": "orchestrator/scripts/verify-omnigent-contract.mjs",
    "mission_3_contract": "orchestrator/scripts/validate-mission-3-contract.mjs",
    "receipt_schemas": "orchestrator/scripts/validate-receipt-schema.mjs"
  }
}
