{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rickgent.local/schemas/ticket-contract-v1.json",
  "title": "Rickgent TicketContract v1",
  "description": "Strict executable ticket identity. Unknown fields and raw shell verification are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "description",
    "depends_on",
    "scope",
    "interfaces",
    "acceptance_criteria",
    "verifications",
    "budgets",
    "digest"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "$ref": "#/$defs/ticketId" },
    "title": { "$ref": "#/$defs/nonEmptyString" },
    "description": { "$ref": "#/$defs/nonEmptyString" },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/ticketId" }
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scopeEntry" }
    },
    "interfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/interface" }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/acceptanceCriterion" }
    },
    "verifications": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/verification" }
    },
    "budgets": { "$ref": "#/$defs/budgets" },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "ticketId": {
      "type": "string",
      "pattern": "^t[0-9]{2,}$"
    },
    "localId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.git(?:/|$))(?!.*//)(?!.*\\\\).+$"
    },
    "scopeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "change_kind", "directory"],
      "properties": {
        "path": { "$ref": "#/$defs/repoPath" },
        "change_kind": {
          "enum": ["create", "modify", "delete", "rename"]
        },
        "directory": { "type": "boolean" },
        "from_path": { "$ref": "#/$defs/repoPath" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "change_kind": { "const": "rename" } },
            "required": ["change_kind"]
          },
          "then": { "required": ["from_path"] },
          "else": { "not": { "required": ["from_path"] } }
        }
      ]
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "direction", "path", "owner", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "direction": { "enum": ["provides", "consumes"] },
        "path": { "$ref": "#/$defs/repoPath" },
        "owner": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "interface_ids", "verification_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "interface_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/localId" }
        },
        "verification_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/localId" }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "executable",
        "args",
        "cwd_class",
        "env_allowlist",
        "timeout_ms",
        "network",
        "writable_outputs",
        "expected_exit_codes"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "executable": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._+/-]+$",
          "not": { "enum": ["sh", "bash", "zsh", "cmd", "powershell", "pwsh"] }
        },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cwd_class": {
          "enum": ["repository_root", "orchestrator_package", "attempt_output"]
        },
        "env_allowlist": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        },
        "network": { "const": "deny" },
        "writable_outputs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repoPath" }
        },
        "expected_exit_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts", "max_review_cycles", "wall_clock_ms", "remediation_limit"],
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 100 },
        "max_review_cycles": { "type": "integer", "minimum": 0, "maximum": 100 },
        "wall_clock_ms": { "type": "integer", "minimum": 1, "maximum": 86400000 },
        "remediation_limit": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    }
  }
}
