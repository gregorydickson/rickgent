{
  "name": "rickgent",
  "version": "0.1.0-alpha",
  "description": "Rickgent reliability-preview engineering toolbelt",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/testing",
    "!dist/testing/**",
    "!dist/internal",
    "!dist/internal/**",
    "!dist/lifecycle/salvage.*"
  ],
  "packageManager": "pnpm@10.22.0",
  "bin": {
    "rickgent": "./dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/generate-build-commit.cjs && node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node -e \"require('node:fs').copyFileSync('pnpm-lock.yaml','dist/pnpm-lock.yaml')\" && chmod +x dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts",
    "doctor": "node dist/cli.js doctor"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "rickgentToolchain": {
    "schemaVersion": "1.0.0",
    "node": {
      "range": ">=24.0.0 <25.0.0"
    },
    "python": {
      "range": ">=3.12.0 <3.15.0",
      "metadata": "rickgent-policies/pyproject.toml"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "10.22.0",
      "lockfile": "orchestrator/pnpm-lock.yaml",
      "lockfileVersion": "9.0"
    },
    "platforms": {
      "supported": ["darwin", "linux"],
      "windows": "fail_fast",
      "windowsErrorCode": "RICKGENT_PLATFORM_UNSUPPORTED"
    }
  }
}
