      "id": "FAULT-GATE-001",
      "description": "Required gate status 'failed' blocks oracle acceptance",
      "inject": { "gate_id": "VER-ORACLE-STORE", "status": "failed" },
      "expected_oracle_result": "rejected",
      "expected_reason_contains": "required_gate_blocking",
      "forbidden_downstream": ["ready_for_delivery", "delivered", "push", "pr"]
    },
